[Unit]
Description=Supply Dispatcher
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=simple
User=supply-dispatcher
Group=supply-dispatcher
SupplementaryGroups=docker
WorkingDirectory=/opt/supply-dispatcher
EnvironmentFile=/etc/supply-dispatcher.env
ExecStart=/usr/bin/python3 /opt/supply-dispatcher/app.py
Restart=on-failure
RestartSec=3
StateDirectory=supply-dispatcher
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/supply-dispatcher

[Install]
WantedBy=multi-user.target
